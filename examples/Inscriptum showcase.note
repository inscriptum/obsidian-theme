{
  "type": "noteDoc",
  "content": [
    {
      "type": "noteTitle",
      "content": [
        {
          "type": "text",
          "text": "Inscriptum showcase"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "A quiet place to collect ideas, shape a draft, and enjoy the words."
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Make room for your next idea"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Good writing starts with a little space. Capture an observation, follow a connection, and turn a rough thought into something worth sharing."
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The best tools leave room for the work itself."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "From a first line to a finished story"
